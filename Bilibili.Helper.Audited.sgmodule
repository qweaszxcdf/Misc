#!name=Bilibili Helper (Fast)
#!desc=Low-latency splash, search and feed ad filtering; no gRPC MITM or PCDN block.
#!homepage=https://github.com/qweaszxcdf/Misc

# Fast mode intentionally avoids gRPC response buffering.
# It does not alter video descriptions, comments, danmaku or playback.
# Other installed Bilibili modules may still MITM grpc.biliapi.net.

[Map Local]
^https:\/\/app\.bilibili\.com(?::443)?\/x\/v2\/splash\/show(?:\?|$) data-type=text data="{\"code\":0,\"message\":\"success\",\"data\":{}}" status-code=200 header="Content-Type:application/json"

[Script]
bilibili-helper-json = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/(?:splash\/(?:list|event\/list2|brand\/list)|search|feed\/index)(?:\?.*)?$,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/bilibili-helper-json.js

[MITM]
hostname = %APPEND% app.bilibili.com
