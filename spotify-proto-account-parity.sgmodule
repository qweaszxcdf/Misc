#!name=Spotify Account Parity (Upstream Matched 9.1.98+)
#!desc=Matches working Amlabort 2026-11-11 upstream for Spotify 9.1.98+; no Premium entitlement guaranteed.
#!icon=https://img.icons8.com/?size=100&id=ZuQiaFCa1vXe&format=png&color=000000
#!date=261112
# Source: https://github.com/Amlabort/MY_clash/blob/0e03454fe90b00cecccf8586ba8922c640dc4812/files/surge/spot-new.module
# Scripts pinned to upstream commit 0e03454fe90b00cecccf8586ba8922c640dc4812 for reproducible behavior.


[Rule]
AND,((DOMAIN-SUFFIX, spotify.com),(PROTOCOL, QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/nebula\/v.\/configuration\/attributes header-del if-none-match
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/remote-config-resolver\/v.\/configuration header-del if-none-match

[URL Rewrite]

#屏蔽弹窗广告
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject

# 屏蔽设置界面会员信息（仅影响展示）
# ^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ - reject

# 屏蔽 AI DJ
^https:\/\/.*37i9dQZF1EYkqdzj48dyYq - reject

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com

[Script]
# spotify-gabo = type=http-request,pattern=^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service,requires-body=0,script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/0e03454fe90b00cecccf8586ba8922c640dc4812/files/lpx/js/spot-gabo.js
spotify-proto-new = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|nebula\/v1\/configuration\/attributes),requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/0e03454fe90b00cecccf8586ba8922c640dc4812/files/lpx/js/261110-spot.js,script-update-interval=0
spotify-remote = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/remote-config-resolver\/v.\/configuration,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/0e03454fe90b00cecccf8586ba8922c640dc4812/files/lpx/js/spot-remote.js,script-update-interval=0

#去广告
NoSearchAd = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/0e03454fe90b00cecccf8586ba8922c640dc4812/files/lpx/js/spot-NoSearchAd.js
# NoHomeAd = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/default,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/0e03454fe90b00cecccf8586ba8922c640dc4812/files/lpx/js/spot-NoHomeAd.js
NoScrollAd = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/0e03454fe90b00cecccf8586ba8922c640dc4812/files/lpx/js/spot-NoScrollAd.js
