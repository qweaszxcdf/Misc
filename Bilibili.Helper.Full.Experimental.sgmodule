#!name=Bilibili Helper (Full Experimental)
#!desc=Full gRPC content filtering; may delay video descriptions and comments. Use Fast version if latency occurs.
#!homepage=https://github.com/qweaszxcdf/Misc

[Rule]
DOMAIN-WILDCARD,*pcdn*.biliapi.net,REJECT

[Map Local]
^https:\/\/app\.bilibili\.com(?::443)?\/x\/v2\/splash\/show(?:\?|$) data-type=text data="{\"code\":0,\"message\":\"success\",\"data\":{}}" status-code=200 header="Content-Type:application/json"

[Script]
bilibili-helper-json = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/(?:splash\/(?:list|event\/list2|brand\/list)|search|feed\/index)(?:\?.*)?$,requires-body=1,max-size=2097152,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/bilibili-helper-json.js
bilibili-helper-grpc = type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/(?:bilibili\.community\.service\.dm\.v1\.DM\/DmView|bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus|bilibili\.app\.view\.v1\.View\/(?:View|ViewProgress)|bilibili\.app\.viewunite\.v1\.View\/View|bilibili\.main\.community\.reply\.v1\.Reply\/MainList|bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll|bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=2097152,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/bilibili-helper-grpc.js

[MITM]
hostname = %APPEND% app.bilibili.com, grpc.biliapi.net
