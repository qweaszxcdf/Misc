#!name=Bilibili gRPC Comments SameReference
#!desc=Diagnostic only: return the exact response Uint8Array object, no copying or parsing.
#!homepage=https://github.com/qweaszxcdf/Misc

# Pair with Bilibili Helper (Fast). Disable all other Bilibili gRPC diagnostics.
# SameReference does not modify payload bytes, but it invokes Surge response replacement.

[Script]
bilibili-grpc-comments-sameref = type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/bilibili-grpc-sameref.js

[MITM]
hostname = %APPEND% grpc.biliapi.net
