#!name=Bilibili gRPC Test D - Video Detail
#!desc=MITM + video View/View and ViewUnite/View scripts only; comments pass through.
#!homepage=https://github.com/qweaszxcdf/Misc

# Diagnostic only. Use together with Bilibili Helper (Fast).
# Enable ONE gRPC diagnostic module at a time.

[Script]
bilibili-grpc-video-detail = type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/(?:bilibili\.app\.view\.v1\.View\/View|bilibili\.app\.viewunite\.v1\.View\/View)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/bilibili-helper-grpc.js

[MITM]
hostname = %APPEND% grpc.biliapi.net
