#!name=Spotify Surge Proto (Optimized)
#!desc=Playback compatibility: Premium account attributes on, risky remote core-ads overrides off; page filtering and GABO on.
#!date=2026-10-29

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT
DOMAIN,adeventtracker.spotify.com,REJECT
DOMAIN,ads-fa.spotify.com,REJECT

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com)(:443)?\/user-customization-service\/v1\/customize(\?.*)?$ header-del if-none-match

[URL Rewrite]
# Dismiss popup
^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com)(:443)?\/pendragon(?:\/|\?|$) - reject
# Hide premium/settings view (enabled by request; may affect plan information)
^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com)(:443)?\/pam-view-service\/ - reject
# Block AI DJ playlist URI (enabled by request; verify impact in app)
^https:\/\/[^\s]*37i9dQZF1EYkqdzj48dyYq - reject

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com

[Script]
spotify-gabo = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com)(:443)?\/gabo-receiver-service(?:\/|\?|$),requires-body=0,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/spotify-gabo.js
spotify-proto-selective = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com)(:443)?\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/spotify-proto.js,argument=premium=1;accountAds=1;remoteAds=0

# Experimental page advertisement filtering (enabled by default)
spotify-search-ads = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com)(:443)?\/browsita\/v[^/]+\/browse(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/spotify-page-ads.js
spotify-home-ads = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com)(:443)?\/casita\/v[^/]+\/home\/default(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/spotify-page-ads.js
spotify-scroll-ads = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com)(:443)?\/scrollsita\/v[^/]+\/scroll\/spotify(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/spotify-page-ads.js
