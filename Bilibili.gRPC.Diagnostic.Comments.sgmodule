#!name=Bilibili gRPC Test E - Comments
#!desc=MITM + Reply/MainList script only; video details pass through.
#!homepage=https://github.com/qweaszxcdf/Misc

# Diagnostic only. Use together with Bilibili Helper (Fast).
# Enable ONE gRPC diagnostic module at a time.

[Script]
bilibili-grpc-comments = type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/bilibili-helper-grpc.js

[MITM]
hostname = %APPEND% grpc.biliapi.net
