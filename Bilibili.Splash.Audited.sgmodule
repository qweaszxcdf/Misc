#!name=Bilibili Splash (Audited)
#!desc=Only Bilibili iOS splash ad endpoints; no P2P or playback API modifications.
#!homepage=https://github.com/qweaszxcdf/Misc

[Map Local]
^https:\/\/app\.bilibili\.com(?::443)?\/x\/v2\/splash\/show(?:\?|$) data-type=text data="{\"code\":0,\"message\":\"success\",\"data\":{}}" status-code=200 header="Content-Type:application/json"

[Script]
bilibili-splash-json = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:list|event\/list2|brand\/list)(?:\?.*)?$,requires-body=1,max-size=2097152,script-path=https://raw.githubusercontent.com/qweaszxcdf/Misc/main/scripts/bilibili-helper-json.js

[MITM]
hostname = %APPEND% app.bilibili.com
